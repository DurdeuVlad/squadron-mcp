# Squadron - Environment Configuration

# ============================================
# AUTHENTICATION (Choose ONE method per agent)
# ============================================

# METHOD 1: Global CLI Login (EASIEST - uses your existing login)
# ────────────────────────────────────────────────────────────────
# If you're already logged in globally (can run `claude`, `gemini`, `codex` in terminal):
# → NO CONFIGURATION NEEDED! The orchestrator auto-detects your login.
#
# To login globally (if not already):
#   claude auth login    (for Claude)
#   gcloud auth login    (for Gemini/Google AI)
#   openai auth login    (for Codex/OpenAI)
#
# The orchestrator will automatically find your credentials in:
#   Windows: %USERPROFILE%\AppData\Roaming\anthropic\config.json
#   Linux/Mac: ~/.anthropic/config.json (or ~/.config/anthropic/config.json)

# METHOD 2: Subscription tokens (when project makes money)
# ────────────────────────────────────────────────────────
# ANTHROPIC_SUBSCRIPTION_TOKEN=your-subscription-token-here
# GOOGLE_SUBSCRIPTION_TOKEN=your-subscription-token-here
# OPENAI_SUBSCRIPTION_TOKEN=your-subscription-token-here

# METHOD 3: API keys (fallback for pay-per-use)
# ────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GOOGLE_API_KEY=your-google-api-key-here
# OPENAI_API_KEY=sk-your-openai-key-here

# Custom endpoints (optional)
# ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1
# GOOGLE_ENDPOINT=https://generativelanguage.googleapis.com/v1
# OPENAI_ENDPOINT=https://api.openai.com/v1

# Agent Configuration
YOLO_MODE=true                    # Auto-approve all gates (default: true)
AUTO_FALLBACK=true                # Auto-switch agents on credit exhaustion (default: true)

# Credit Limits (tokens per day)
# Note: These are automatically adjusted based on auth method:
#   - Global CLI / Subscription: 10x higher (10M, 20M, 5M)
#   - API Key: Standard limits (1M, 2M, 500k)
CLAUDE_DAILY_LIMIT=1000000        # 1M (API) or 10M (CLI/subscription)
GEMINI_DAILY_LIMIT=2000000        # 2M (API) or 20M (CLI/subscription)
CODEX_DAILY_LIMIT=500000          # 500k (API) or 5M (CLI/subscription)

# Server Configuration
MCP_SERVER_PORT=3000
LOG_LEVEL=info

# Auto-Inject Context (paths relative to workspace)
AGENTS_RULES_PATH=AGENTS.md
GEMINI_PROTOCOL_PATH=GEMINI.md
CLAUDE_PROTOCOL_PATH=CLAUDE.md
FOLDER_CONVENTIONS_PATH=.github/copilot-instructions.md
SPRINT_METHODOLOGY_PATH=sprints/SPRINT_METHODOLOGY.md

# Workflow Settings
AUTO_QA=true                      # Run QA automatically at each step
AUTO_FIX=true                     # Auto-fix issues when possible
MAX_RETRY_ATTEMPTS=3              # Max retries per task on failure

# QA Settings (Sprint 007)
QA_ENABLED=true                   # Enable context-aware QA prompt injection
QA_HALT_ON_CRITICAL=true          # Stop workflow on failed critical QA checks
QA_SELF_REVIEW=true               # Agent performs self-review before reporting
QA_AUTOMATED_CHECKS=true          # Run automated checks when available
QA_MIN_QUALITY_SCORE=7            # Minimum quality score required per QA stage (1-10)
QA_AGENT_SELECTION=auto           # auto | claude | gemini | codex

# Auto-Orchestration Settings (Sprint 006)
AUTO_TRIGGER_WORKFLOWS=true       # Enable intelligent workflow triggering
AUTO_TRIGGER_CONFIDENCE=0.8       # Min confidence to trigger or ask confirmation
AUTO_TRIGGER_ASK_FIRST=true       # Ask confirmation for medium confidence requests
YOLO_MODE_CONFIDENCE=0.95         # Auto-trigger without confirmation above this
CONFIRMATION_TIMEOUT=3000         # Auto-select confirmation option A after N ms
CONTEXT_DETECTION_ENABLED=true    # Use file/folder context to adjust confidence
