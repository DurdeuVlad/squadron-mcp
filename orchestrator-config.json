        "command": "C:\\Users\\User\\AppData\\Roaming\\npm\\claude.cmd",
        "args": [
          "-p",
          "{prompt}",
          "--output-format",
          "json",
          "--permission-mode",
          "bypassPermissions",
          "--dangerously-skip-permissions"
        ],
        "successExitCodes": [0]
      },
      "gemini": {
        "command": "C:\\Users\\User\\AppData\\Roaming\\npm\\gemini.cmd",
        "args": ["-p", "", "--output-format", "json", "--approval-mode", "yolo"],
        "passPromptViaStdin": true,
        "successExitCodes": [0]
      },
      "codex": {
        "command": "C:\\Users\\User\\AppData\\Roaming\\npm\\codex.cmd",
        "args": [
          "exec",
          "--dangerously-bypass-approvals-and-sandbox",
          "-",
