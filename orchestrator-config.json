      "role": "reviewer",
      "capabilities": ["planning", "execution", "review", "validation"],
      "tokenBudget": 500000,
      "costPerToken": 0.00002
    }
  },
  "stateStorage": "file",
  "delegationRuntime": {
    "enabled": true,
    "defaultTimeoutMs": 120000,
    "maxOutputBytes": 131072,
    "fallbackOnFailure": true,
    "fallbackExecutors": {
      "claude": ["codex"],
      "gemini": ["codex"],
      "codex": []
    },
    "agents": {
